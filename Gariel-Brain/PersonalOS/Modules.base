filters:
  and:
    - file.inFolder("PersonalOS/Module Registry")
    - note["type"] == "personal-os-module"
properties:
  note["name"]:
    displayName: 模块
  note["id"]:
    displayName: ID
  note["enabled"]:
    displayName: 启用
  note["order"]:
    displayName: 顺序
  note["folders"]:
    displayName: 知识目录
  note["icon"]:
    displayName: 图标
  note["color"]:
    displayName: 颜色
views:
  - type: table
    name: 模块注册表
    order:
      - note["name"]
      - note["id"]
      - note["enabled"]
      - note["order"]
      - note["folders"]
      - note["icon"]
      - note["color"]
    sort:
      - property: note["order"]
        direction: ASC
